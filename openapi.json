      "get": {
        "tags": [
          "Root"
        ],
        "summary": "Get Root",
        "description": "Root endpoint welcoming users and providing a basic hint on how to use the API.",
        "operationId": "get_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/routes/{route_id}/vehicles": {
      "get": {
        "tags": [
          "Vehicles"
        ],
        "summary": "Get Vehicles By Route",
        "description": "Returns a collection of currently active vehicles specifically assigned to the requested route ID.",
        "operationId": "get_vehicles_by_route_routes__route_id__vehicles_get",
        "parameters": [
          {
            "name": "route_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Route Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/alerts": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "Get All Alerts",
        "description": "Returns a full collection of all currently active transit alerts across the entire GRT network.",
        "operationId": "get_all_alerts_alerts_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/routes/{route_id}/alerts": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "Get Alerts By Route",
        "description": "Returns a collection of active transit alerts filtered dynamically to only ones impacting the requested route ID.",
        "operationId": "get_alerts_by_route_routes__route_id__alerts_get",
        "parameters": [
          {
            "name": "route_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Route Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
