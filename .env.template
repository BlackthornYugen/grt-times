# API keys — GRT doesn't require one.
TRANSIT_TTC_API_KEY=your_ttc_key_here
TRANSIT_OCT_API_KEY=your_octranspo_key_here

# Host regexes — first match wins. Defaults match any host whose first label
# is the agency code (e.g. ttc.jskw.ca, ttc.*.onion, ttc.localhost all match ^ttc\.)
# Unmatched hosts fall back to GRT.
# TRANSIT_GRT_HOST_REGEX=^grt\.
# TRANSIT_TTC_HOST_REGEX=^ttc\.
# TRANSIT_OCT_HOST_REGEX=^oct\.
